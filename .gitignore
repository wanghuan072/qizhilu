# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
/logs
/pids
# testing
/coverage
/lib/data/articles.json
/lib/data/games.json
/lib/data/gameTags.json
/lib/data/localeSiteSettings.json

# next.js
/.next/
out/
/out/

# production
/build
*.zip

# misc
.DS_Store
*.pem
.claude/settings.local.json

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment variables and secrets (隐私文件 - 不要上传到 GitHub)
.env
.env.local
.env.development
.env.development.local
.env.production
.env.production.local
.env.test
.env.test.local
.env*.local
*.env
.envrc

# API keys and secrets
**/secrets/
**/*secret*
**/*key*
**/*token*
**/*password*
**/*credential*

# Auto-generated config files with sensitive data
lib/config/siteSettings.ts
lib/data/*.json
!lib/data/gameTags.json
!lib/data/localeSiteSettings.json

# vercel
.vercel

# typescript
*.tsbuildinfo
.idea
.next
nohup.out

# SpecStory explanation file
.SpecStory
.husky
